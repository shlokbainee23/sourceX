.env
.env.*
.venv/
venv/
ENV/
env/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local

# Databases & Runtime Generated Files
backend/data/sih26237.sqlite
backend/data/documents/*.bin
backend/data/documents/*.pdf
